{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/storage/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME":       "Surveillance",
    "APP_ENV":        "production",
    "APP_DEBUG":      "false",
    "APP_KEY":        "@APP_KEY",
    "APP_URL":        "@APP_URL",
    "DB_CONNECTION":  "mysql",
    "DB_HOST":        "@DB_HOST",
    "DB_PORT":        "@DB_PORT",
    "DB_DATABASE":    "@DB_DATABASE",
    "DB_USERNAME":    "@DB_USERNAME",
    "DB_PASSWORD":    "@DB_PASSWORD",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE":    "array",
    "QUEUE_CONNECTION":"sync",
    "MAIL_MAILER":    "smtp",
    "MAIL_HOST":      "@MAIL_HOST",
    "MAIL_PORT":      "@MAIL_PORT",
    "MAIL_USERNAME":  "@MAIL_USERNAME",
    "MAIL_PASSWORD":  "@MAIL_PASSWORD",
    "ARDUINO_API_KEY":"@ARDUINO_API_KEY"
  }
}
